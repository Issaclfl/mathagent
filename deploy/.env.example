# 复制为 .env 并填写（生产部署必填项带 :? 校验，缺失会拒绝启动）
# ── 鉴权（公网必填）────────────────────────────
AUTH_PASSWORD=请设置一个强密码
AUTH_SECRET=请设置一个随机字符串（openssl rand -hex 32）

# ── LLM（与本地 .env 相同）─────────────────────
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
