# 复制本文件为 .env 并填入真实密钥。.env 已被 .gitignore 忽略，不会提交。
# LLM_API_KEY 也可通过系统环境变量注入（优先级：环境变量 > .env）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
# 单次输出上限（token）。默认不发送（交给服务端决定，实测 deepseek-v4-flash
# 传 8192 会被提前截断导致长代码生成失败）；仅当模型明确支持更大值时设置
# LLM_MAX_TOKENS=8192
